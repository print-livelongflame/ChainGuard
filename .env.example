# Path to the separate detector repository, relative to this project directory.
# The default expects ../ChainGuard-detector-template.
DETECTOR_PATH=../ChainGuard-detector-template

# Choose openai, gemini, or claude. Set the matching provider key below.
CHAINGUARD_AI_PROVIDER=openai
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
CLAUDE_API_KEY=

# Required for Ethereum fetchers; detector auth key is optional.
ETHERSCAN_API_KEY=
DETECTOR_API_KEY=
